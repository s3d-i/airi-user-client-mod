{
  "name": "@airi-client-mod/local-hub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @airi-client-mod/local-hub^... build && tsc --project tsconfig.build.json",
    "build:watch": "tsc --project tsconfig.build.json --watch --preserveWatchOutput",
    "clean": "rimraf dist",
    "dev": "pnpm run build && (pnpm --filter @airi-client-mod/local-hub^... --parallel run build:watch & pnpm run build:watch & node --watch dist/index.js)",
    "start": "pnpm run build && node dist/index.js",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@airi-client-mod/airi-ws-bridge": "workspace:*",
    "@airi-client-mod/hub-debug-surface": "workspace:*",
    "@airi-client-mod/hub-ingress-ws": "workspace:*",
    "@airi-client-mod/hub-runtime": "workspace:*",
    "@airi-client-mod/hub-trace-store": "workspace:*",
    "@guiiai/logg": "^1.2.11"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts"
}
